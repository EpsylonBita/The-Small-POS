  nsExec::ExecToLog '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$PLUGINSDIR\delete-managed-credentials.ps1" "repair_scope_v1.the-small-pos" "repair_queue_aes_key_v1.the-small-pos" "repair_entitlement_v1.the-small-pos" "repair_actor_attestation_v1.the-small-pos" "repair_scope_transition_journal_v1.the-small-pos" "admin_dashboard_url.the-small-pos" "terminal_id.the-small-pos" "pos_api_key.the-small-pos" "branch_id.the-small-pos" "organization_id.the-small-pos" "business_type.the-small-pos" "supabase_url.the-small-pos" "supabase_anon_key.the-small-pos" "ghost_mode_feature_enabled.the-small-pos" "callerid_sip_password.the-small-pos" "callerid_activation_cache_manifest_v1.the-small-pos" "callerid_activation_cache_a0_v1.the-small-pos" "callerid_activation_cache_a1_v1.the-small-pos" "callerid_activation_cache_a2_v1.the-small-pos" "callerid_activation_cache_a3_v1.the-small-pos" "callerid_activation_cache_a4_v1.the-small-pos" "callerid_activation_cache_a5_v1.the-small-pos" "callerid_activation_cache_a6_v1.the-small-pos" "callerid_activation_cache_a7_v1.the-small-pos" "callerid_activation_cache_b0_v1.the-small-pos" "callerid_activation_cache_b1_v1.the-small-pos" "callerid_activation_cache_b2_v1.the-small-pos" "callerid_activation_cache_b3_v1.the-small-pos" "callerid_activation_cache_b4_v1.the-small-pos" "callerid_activation_cache_b5_v1.the-small-pos" "callerid_activation_cache_b6_v1.the-small-pos" "callerid_activation_cache_b7_v1.the-small-pos" "pos_session.the-small-pos"'
  Pop $0
  ${If} $0 <> 0
    MessageBox MB_OK|MB_ICONEXCLAMATION "Some saved POS credentials could not be removed. See the uninstall log. / Δεν ήταν δυνατή η διαγραφή ορισμένων αποθηκευμένων διαπιστευτηρίων POS. Δείτε το αρχείο καταγραφής."
